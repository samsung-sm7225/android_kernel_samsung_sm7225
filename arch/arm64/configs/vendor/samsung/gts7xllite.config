#
# Samsung Galaxy Tab S7 FE 5G .config file
#

#
# "Project"
#
# CONFIG_MACH_GTS7XLLITE_CHN_OPEN is not set
# CONFIG_MACH_GTS7XLLITE_KOR_OPEN is not set
# CONFIG_MACH_GTS7XLLITE_MEA_TUR is not set
# CONFIG_MACH_GTS7XLLITE_USA_SINGLE is not set
CONFIG_MACH_GTS7XLLITE_EUR_OPEN=y
CONFIG_SEC_GTS7XLLITE_PROJECT=y

#
# "Library routines"
#
CONFIG_XXHASH=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y

#
# "Input device support"
#
CONFIG_INPUT_MATRIXKMAP=y

#
# "Samsung battery support"
#
CONFIG_CHARGER_SM5440=y
CONFIG_STEP_CHARGING=y
CONFIG_DIRECT_CHARGING=y
CONFIG_HICCUP_CHARGER=y
CONFIG_TABLET_MODEL_CONCEPT=y

#
# "Sound"
#
# CONFIG_SND_SOC_SAMSUNG_JACK is not set
# CONFIG_SND_SOC_SAMSUNG_MBHC_SUPPORT is not set
CONFIG_SND_SOC_CIRRUS_AMP=y
CONFIG_SND_SOC_CS35L45=y
CONFIG_SND_SOC_CS35L45_I2C=y
CONFIG_SND_SOC_DBMDX=y
CONFIG_SND_SOC_DBMDX_SND_CAPTURE=y
CONFIG_SND_SOC_DBMDX_VA_NS_SUPPORT=y
CONFIG_SND_SOC_WM_ADSP=y
CONFIG_SND_SOC_WM_ADSP_ANDROID_R=y

#
# "Panels"
#
# CONFIG_SEC_DISPLAYPORT_AUX_CONTROL is not set
# CONFIG_SEC_DISPLAYPORT_ENG is not set
# CONFIG_SEC_DISPLAYPORT_MST is not set
CONFIG_PANEL_FT8203_TS124QDM_WQXGA=y
CONFIG_PANEL_HX83102_TV104WUM_WUXGA=y
CONFIG_PANEL_HX83121_PPC357DB11_WQXGA=y
CONFIG_SEC_DISPLAYPORT=y
CONFIG_SEC_DISPLAYPORT_BIGDATA=y
CONFIG_SEC_DISPLAYPORT_LOGGER=y

#
# "Module Signature"
#
# CONFIG_MODULE_FORCE_LOAD is not set
CONFIG_MODULE_SIG_FORCE=y

#
# "SM5714"
#
# CONFIG_SM5714_SUPPORT_SBU is not set
# CONFIG_SM5714_WATER_DETECTION_ENABLE is not set
# CONFIG_LEDS_SM5714 is not set

#
# "Touchscreen"
#
# CONFIG_HALL_DUMP_KEY_MODE is not set
# CONFIG_HMX_DB is not set
# CONFIG_SEC_AOT is not set
# CONFIG_TOUCHSCREEN_HIMAX_EMBEDDED_FIRMWARE is not set
# CONFIG_TOUCHSCREEN_HIMAX_I2C is not set
# CONFIG_TOUCHSCREEN_HIMAX_IC_HX83102 is not set
# CONFIG_TOUCHSCREEN_HIMAX_IC_HX83103 is not set
# CONFIG_TOUCHSCREEN_HIMAX_IC_HX83106 is not set
# CONFIG_TOUCHSCREEN_HIMAX_IC_HX83111 is not set
# CONFIG_TOUCHSCREEN_HIMAX_IC_HX83112 is not set
# CONFIG_TOUCHSCREEN_HIMAX_IC_HX83113 is not set
# CONFIG_TOUCHSCREEN_HIMAX_IC_HX83191 is not set
# CONFIG_TOUCHSCREEN_HIMAX_ONCELL is not set
# CONFIG_INPUT_SEC_SECURE_TOUCH is not set
# CONFIG_INPUT_TOUCHSCREEN_TCLMV2 is not set
# CONFIG_SEC_INPUT_BOOSTER_HANDLER is not set
# CONFIG_TOUCHSCREEN_DUAL_FOLDABLE is not set
CONFIG_SEC_AUTO_INPUT=y
CONFIG_INPUT_SEC_INPUT=y
CONFIG_INPUT_SEC_NOTIFIER=y
CONFIG_TOUCHSCREEN_DUMP_MODE=y
CONFIG_TOUCHSCREEN_FTS_FT820X=y
CONFIG_TOUCHSCREEN_HIMAX_CHIPSET=y
CONFIG_TOUCHSCREEN_HIMAX_COMMON=y
CONFIG_TOUCHSCREEN_HIMAX_DEBUG=y
CONFIG_TOUCHSCREEN_HIMAX_IC_HX83121=y
CONFIG_TOUCHSCREEN_HIMAX_INCELL_CORE=y
CONFIG_TOUCHSCREEN_HIMAX_INSPECT=y
CONFIG_TOUCHSCREEN_HIMAX_SPI=y

#
# "Hall"
#
CONFIG_HALL_LOGICAL=y
CONFIG_HALL_NOTIFIER=y
CONFIG_INPUT_HALL_IC=y

#
# "Hardware I/O ports"
#
CONFIG_EPEN_WACOM_WEZ01=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=16

#
# "DM-Verity"
#
CONFIG_DM_ANDROID_VERITY_AT_MOST_ONCE_DEFAULT_ENABLED=y

#
# "EroFS"
#
# CONFIG_EROFS_FS_DEBUG is not set
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_CLUSTER_PAGE_LIMIT=1
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_ZIP=y

#
# "Kernel Image Configuration"
#
# CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE is not set
# CONFIG_BUILD_ARM64_KERNEL_COMPRESSION_GZIP is not set
CONFIG_BUILD_ARM64_UNCOMPRESSED_KERNEL=y

#
# "F2FS"
#
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_LZO=y
CONFIG_F2FS_FS_ZSTD=y

#
# "Speakup console speech"
#
# CONFIG_SUPPORT_PS5169_ADBTUNE is not set
CONFIG_COMBO_REDRIVER_PS5169=y

#
# "Sensor Drivers"
#
# CONFIG_SENSORS_A96T3X6_LDO_SHARE is not set
# CONFIG_SENSORS_A96T3X6_SUB is not set
# CONFIG_SENSORS_A96T3x6_WIFI_BLOCK_UNKNOWN_1CH is not set
# CONFIG_SENSORS_ISG6320 is not set
# CONFIG_SENSORS_SX9364 is not set
# CONFIG_USE_MULTI_CHANNEL is not set
CONFIG_SENSORS_A96T3X6=y
CONFIG_SENSORS_A96T3X6_2CH=y
CONFIG_SENSORS_A96T3X6_BLOCK_SAR_ONLY=y
CONFIG_SENSORS_A96T3X6_CRC_CHECK=y
CONFIG_SENSORS_A96T3X6_HALL_NOTIFIER=y
CONFIG_SENSORS_A96T3X6_UNSUPPORT_OTG=y
CONFIG_SENSORS_A96T3X6_WIFI=y
CONFIG_SENSORS_A96T3X6_WIFI_2CH=y

#
# "Factory Sensor Drivers"
#
# CONFIG_FLIP_COVER_DETECTOR_FACTORY is not set
# CONFIG_LSM6DSL_FACTORY is not set
# CONFIG_MMC5603X_FACTORY is not set
# CONFIG_STK31610_FACTORY is not set
CONFIG_AK09918_FACTORY=y
CONFIG_LSM6DSO_FACTORY=y
CONFIG_SUPPORT_DUAL_OPTIC=y
CONFIG_SUPPORT_VIRTUAL_OPTIC=y
CONFIG_VEML3235_FACTORY=y
CONFIG_VEML3235_SUB_FACTORY=y

#
# "Camera Configuration"
#
# CONFIG_CAMERA_ADAPTIVE_MIPI is not set
# CONFIG_HI1336_SENSOR is not set
# CONFIG_S5K3L6_SENSOR is not set
# CONFIG_SAMSUNG_CAMERA_OTP_MACRO is not set
# CONFIG_SAMSUNG_CAMERA_OTP_UW is not set
# CONFIG_SAMSUNG_MULTI_CAMERA is not set
# CONFIG_SAMSUNG_OIS_MCU_STM32 is not set
# CONFIG_SAMSUNG_REAR_QUAD is not set
# CONFIG_SAMSUNG_REAR_TRIPLE is not set
CONFIG_GC5035_MACRO_OTP_DD_AUTOLOAD=y
CONFIG_GC5035_SENSOR=y
CONFIG_SAMSUNG_CAMERA_OTP=y
CONFIG_SAMSUNG_CAMERA_OTP_FRONT=y

#
# "Memory Management Options"
#
CONFIG_MMAP_READAROUND_LIMIT=8

#
# "Regulator"
#
CONFIG_REGULATOR_S2MPB03=y

#
# "USB Physical Layer drivers"
#
# CONFIG_DISABLE_LOCKSCREEN_USB_RESTRICTION is not set

#
# "Section Mismatch"
#
# CONFIG_DEBUG_SECTION_MISMATCH is not set
# CONFIG_SECTION_MISMATCH_WARN_ONLY is not set

#
# "Keyboard"
#
# CONFIG_KEYBOARD_STM32_POGO_V2 is not set
# CONFIG_KEYBOARD_STM32_POGO_V3 is not set
CONFIG_KEYBOARD_STM32_POGO=y

#
# "NFC"
#
# CONFIG_NFC_NQ is not set

#
# "Serial drivers"
#
# CONFIG_MUIC_LO_TA_LOW_CURRENT is not set