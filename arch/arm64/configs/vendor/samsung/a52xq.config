#
# Samsung Galaxy A52 5G .config file
#

#
# "Project"
#
# CONFIG_MACH_A52XQ_CAN_SINGLE is not set
# CONFIG_MACH_A52XQ_CHN_HK is not set
# CONFIG_MACH_A52XQ_CHN_OPEN is not set
# CONFIG_MACH_A52XQ_JPN_DCM is not set
# CONFIG_MACH_A52XQ_KOR_SINGLE is not set
# CONFIG_MACH_A52XQ_USA_OPEN is not set
# CONFIG_MACH_A52XQ_USA_SINGLE is not set
CONFIG_MACH_A52XQ_EUR_OPEN=y
CONFIG_SEC_A52XQ_PROJECT=y

#
# "Samsung battery support"
#
# CONFIG_TABLET_MODEL_CONCEPT is not set
CONFIG_CHARGER_PCA9468=y
CONFIG_SEND_PDMSG_IN_PPS_REQUEST_WORK=y
CONFIG_STEP_CHARGING=y
CONFIG_DIRECT_CHARGING=y
CONFIG_HICCUP_CHARGER=y

#
# "Sound"
#
# CONFIG_SND_SOC_CIRRUS_AMP is not set
# CONFIG_SND_SOC_CS35L45_I2C is not set
# CONFIG_SND_SOC_DBMDX is not set
# CONFIG_SND_SOC_WM_ADSP_ANDROID_R is not set
CONFIG_SND_SOC_SAMSUNG_JACK=y
CONFIG_SND_SOC_SAMSUNG_MBHC_SUPPORT=y

#
# "Vibrator"
#
CONFIG_DC_VIBRATOR=y
CONFIG_SEC_VIBRATOR=y
CONFIG_SEC_VIB_NOTIFIER=y

#
# "SM5714"
#
CONFIG_SM5714_SUPPORT_SBU=y
CONFIG_SM5714_WATER_DETECTION_ENABLE=y
CONFIG_LEDS_SM5714=y

#
# "Panels"
#
# CONFIG_SEC_DISPLAYPORT is not set
# CONFIG_SEC_DISPLAYPORT_BIGDATA is not set
CONFIG_PANEL_S6E3FC3_AMS646YD01_FHD=y

#
# "Module Signature"
#
# CONFIG_MODULE_FORCE_LOAD is not set
CONFIG_MODULE_SIG_FORCE=y

#
# "Touchscreen"
#
# CONFIG_EPEN_WACOM_WEZ01 is not set
# CONFIG_HALL_DUMP_KEY_MODE is not set
# CONFIG_HALL_LOGICAL is not set
# CONFIG_INPUT_MATRIXKMAP is not set
CONFIG_SEC_AUTO_INPUT=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=16
CONFIG_HALL_NOTIFIER=y
CONFIG_INPUT_HALL_IC=y
CONFIG_TOUCHSCREEN_STM_FTS5CU56A=y
CONFIG_TOUCHSCREEN_ZINITIX_ZT7650=y

#
# "DM-Verity"
#
CONFIG_DM_ANDROID_VERITY_AT_MOST_ONCE_DEFAULT_ENABLED=y

#
# "NFC"
#
# CONFIG_ESE_COLDRESET is not set
# CONFIG_ESE_FACTORY_ONLY is not set
# CONFIG_ESE_SECURE is not set
# CONFIG_ESE_USE_REGULATOR is not set
# CONFIG_ESE_USE_TZ_API is not set
# CONFIG_MAKE_NODE_USING_PLATFORM_DEVICE is not set
# CONFIG_NFC_FEATURE_SN100U is not set
# CONFIG_NFC_P61 is not set
# CONFIG_NFC_PN547 is not set
# CONFIG_NFC_PVDD_LATE_ENABLE is not set
# CONFIG_NFC_QTI_I2C is not set
# CONFIG_SAMSUNG_NFC is not set
# CONFIG_SEC_NFC_COMPAT_IOCTL is not set
# CONFIG_SEC_NFC_DUPLICATED_IRQ_WQ_LSI is not set
# CONFIG_SEC_NFC_DUPLICATED_IRQ_WQ_QC is not set
# CONFIG_SEC_NFC_LOGGER_ADD_ACPM_LOG is not set
# CONFIG_SEC_STAR is not set
# CONFIG_STAR_K250A is not set
# CONFIG_STAR_MEMORY_LEAK is not set
CONFIG_ESE_P3_LSI=y
CONFIG_SEC_NFC=y
CONFIG_SEC_NFC_LOGGER=y
CONFIG_SEC_NFC_WAKELOCK_METHOD=0

#
# "Fingerprint"
#
# CONFIG_SENSORS_EC6XX is not set
# CONFIG_SENSORS_EL7XX is not set
# CONFIG_SENSORS_ET5XX is not set
# CONFIG_SENSORS_FINGERPRINT_32BITS_PLATFORM_ONLY is not set
# CONFIG_SENSORS_FINGERPRINT_LSI is not set
# CONFIG_SENSORS_FINGERPRINT_MODULE is not set
# CONFIG_SENSORS_FINGERPRINT_MTK is not set
# CONFIG_SENSORS_FINGERPRINT_NORMALSPI is not set
# CONFIG_SENSORS_FPRINT_SECURE is not set
# CONFIG_SENSORS_GW3X is not set
# CONFIG_SENSORS_GW9558X is not set
# CONFIG_SENSORS_QBT2000 is not set
# CONFIG_SENSORS_QFS4008 is not set
# CONFIG_SEC_INPUT_BOOSTER_HANDLER is not set
CONFIG_SENSORS_FINGERPRINT=y
CONFIG_INPUT_SEC_SECURE_TOUCH=y
CONFIG_INPUT_TOUCHSCREEN_TCLMV2=y
CONFIG_TOUCHSCREEN_DUMP_MODE=y
CONFIG_FINGERPRINT_SECURE=y
CONFIG_SENSORS_ET7XX=y
CONFIG_SENSORS_FINGERPRINT_QCOM=y

#
# "Sensor Drivers"
#
# CONFIG_SENSORS_A96T3X6 is not set
# CONFIG_SENSORS_A96T3X6_2CH is not set
# CONFIG_SENSORS_A96T3X6_BLOCK_SAR_ONLY is not set
# CONFIG_SENSORS_A96T3X6_CRC_CHECK is not set
# CONFIG_SENSORS_A96T3X6_HALL_NOTIFIER is not set
# CONFIG_SENSORS_A96T3X6_LDO_SHARE is not set
# CONFIG_SENSORS_A96T3X6_SUB is not set
# CONFIG_SENSORS_A96T3X6_UNSUPPORT_OTG is not set
# CONFIG_SENSORS_A96T3X6_WIFI is not set
# CONFIG_SENSORS_A96T3X6_WIFI_2CH is not set
# CONFIG_SENSORS_A96T3x6_WIFI_BLOCK_UNKNOWN_1CH is not set
# CONFIG_SENSORS_ISG6320 is not set
# CONFIG_USE_MULTI_CHANNEL is not set
CONFIG_SENSORS_SX9364=y

#
# "Camera Configuration"
#
# CONFIG_SAMSUNG_CAMERA_OTP_FRONT is not set
CONFIG_CAMERA_ADAPTIVE_MIPI=y
CONFIG_GC5035_MACRO_OTP_DD_AUTOLOAD=y
CONFIG_GC5035_SENSOR=y
CONFIG_HI1336_SENSOR=y
CONFIG_S5K3L6_SENSOR=y
CONFIG_SAMSUNG_CAMERA_OTP=y
CONFIG_SAMSUNG_CAMERA_OTP_MACRO=y
CONFIG_SAMSUNG_CAMERA_OTP_UW=y
CONFIG_SAMSUNG_MULTI_CAMERA=y
CONFIG_SAMSUNG_OIS_MCU_STM32=y
CONFIG_SAMSUNG_REAR_QUAD=y
CONFIG_SAMSUNG_REAR_TRIPLE=y

#
# "Factory Sensor Drivers"
#
# CONFIG_LSM6DSL_FACTORY is not set
# CONFIG_MMC5603X_FACTORY is not set
# CONFIG_SUPPORT_DUAL_OPTIC is not set
# CONFIG_SUPPORT_VIRTUAL_OPTIC is not set
# CONFIG_VEML3235_FACTORY is not set
# CONFIG_VEML3235_SUB_FACTORY is not set
CONFIG_AK09918_FACTORY=y
CONFIG_FLIP_COVER_DETECTOR_FACTORY=y
CONFIG_LSM6DSO_FACTORY=y
CONFIG_STK31610_FACTORY=y

#
# "Speakup console speech"
#
# CONFIG_COMBO_REDRIVER_PS5169 is not set

#
# "Regulator"
#
CONFIG_REGULATOR_S2MPB03=y

#
# "Memory Management options"
#
CONFIG_MMAP_READAROUND_LIMIT=16

#
# "Section Mismatch"
#
# CONFIG_DEBUG_SECTION_MISMATCH is not set
# CONFIG_SECTION_MISMATCH_WARN_ONLY is not set

#
# "Serial drivers"
#
# CONFIG_MUIC_LO_TA_LOW_CURRENT is not set